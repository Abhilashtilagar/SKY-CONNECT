# Copy this file to .env and fill in your values.
# Django secret key (generate a strong random string for production)
SECRET_KEY=django-insecure-change-me-in-production

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts (e.g. example.com,www.example.com)
ALLOWED_HOSTS=*

# Comma-separated list of allowed CORS origins for the frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://skyconnect-frontend.onrender.com

# Set CORS_ALLOW_ALL_ORIGINS=True only for development
CORS_ALLOW_ALL_ORIGINS=False

# Server port (used by uvicorn startup command)
PORT=8000
